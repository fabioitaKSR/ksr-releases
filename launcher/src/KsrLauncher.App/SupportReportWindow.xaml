<Window x:Class="KsrLauncher.App.SupportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a Problem" Width="760" Height="700" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="#070A0C">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="REPORT A PROBLEM" Foreground="{StaticResource OrangeBrush}" FontSize="27" FontWeight="Black" />
            <TextBlock x:Name="ReportTypeText" Text="SEND KSP LOG" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="Describe the problem and review exactly what will be sent." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="PLAYER" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                <TextBlock x:Name="PlayerText" Grid.Column="1" Margin="0,0,0,7" />
                <TextBlock Grid.Row="1" Text="CAMPAIGN" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                <TextBlock x:Name="CampaignText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,7" />
                <TextBlock Grid.Row="2" Text="SOURCE" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="WHAT HAPPENED?" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="DescriptionTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="145" MaxLength="4000"
                     TextChanged="InputChanged" />
            <StackPanel Grid.Row="4">
                <TextBlock Text="FILES INCLUDED" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" />
                <TextBlock x:Name="IncludedFilesText" Foreground="#FFD5D1C9" Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="SaveWarningText" Foreground="#FFFFB04A" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Return to the KSP main menu before sending a save, so its files are no longer changing." />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="ConsentCheckBox" Grid.Row="6" Checked="InputChanged" Unchecked="InputChanged">
            <TextBlock Text="I understand these diagnostic files will be uploaded to the KSR server." TextWrapping="Wrap" />
        </CheckBox>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Waiting for your description and consent." TextWrapping="Wrap" />
                <ProgressBar x:Name="ProgressBar" Height="3" Margin="0,7,18,0" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
            <Button Grid.Column="1" Content="CANCEL" MinWidth="112" Click="Cancel_Click" />
            <Button x:Name="SendButton" Grid.Column="3" Content="SEND REPORT" Style="{StaticResource PrimaryButton}"
                    MinWidth="178" IsEnabled="False" Click="Send_Click" />
        </Grid>
    </Grid>
</Window>
