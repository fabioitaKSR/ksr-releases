<Window x:Class="KsrLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSR Platform" Width="1480" Height="880" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#070A0C">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.55,0.5" RadiusX="0.85" RadiusY="0.85">
                <GradientStop Color="#FF101820" Offset="0" />
                <GradientStop Color="#FF070A0C" Offset="0.72" />
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F207090B" BorderBrush="#FF2D3032" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KSR" Foreground="{StaticResource OrangeBrush}" FontSize="38" FontWeight="Black" />
                    <Border Width="1" Height="42" Background="#FF34383A" Margin="18,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ACCOUNT" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0" />
                    <TextBlock Text="●" Foreground="#FFD0C9BD" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="AccountNameText" Text="PLAYER" FontSize="18" Margin="10,0,42,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerStatusDot" Text="●" Foreground="{StaticResource GreenBrush}" FontSize="19" VerticalAlignment="Center" />
                    <TextBlock x:Name="ServerStatusText" Text="SERVER ONLINE" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold" Margin="9,0,28,0" VerticalAlignment="Center" />
                    <TextBlock Text="DEVELOPMENT SESSION" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="SETTINGS" Margin="0,0,12,0" />
                    <Button Content="SIGN OUT" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,18,28,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="PlayerTabButton" Grid.Column="0" Content="PLAYER AREA" FontSize="19" Foreground="{StaticResource OrangeBrush}"
                    BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1,1,1,0" Click="PlayerTab_Click" />
            <Button x:Name="AdminTabButton" Grid.Column="1" Content="ADMIN AREA" FontSize="19" Foreground="{StaticResource MutedBrush}"
                    BorderThickness="1,1,1,0" Click="AdminTab_Click" />
        </Grid>

        <Grid x:Name="PlayerArea" Grid.Row="2" Margin="28,18,28,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="MY CAMPAIGNS" Style="{StaticResource SectionTitle}" />
                    <Grid Grid.Row="2" Background="#D90C1013">
                        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="62" /><RowDefinition Height="62" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Text="CAMPAIGN ID" Margin="14" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="CAMPAIGN" Margin="14" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="2" Text="ROLE" Margin="14" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="3" Text="NATION" Margin="14" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="4" Text="STATUS" Margin="14" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Row="1" Text="KSR-000042-20260819-0015" Margin="14" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Space Race 2026" Margin="14" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="2" Text="ADMIN" Margin="14" Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="3" Text="USSR" Margin="14" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="4" Text="ACTIVE" Margin="14" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="KSR-000077-20260820-192600" Margin="14" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Race to Duna" Margin="14" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="2" Text="PLAYER" Margin="14" Foreground="#FF4AB8F1" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="3" Text="USA" Margin="14" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="4" Text="ACTIVE" Margin="14" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="3" Text="Select a campaign to download its Master Save or launch KSP." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="JOIN A CAMPAIGN" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                        <TextBox Text="ENTER CAMPAIGN ID" Foreground="#FF6D7376" Margin="0,0,0,14" />
                        <Button Style="{StaticResource PrimaryButton}" Content="DOWNLOAD MASTER SAVE" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="KSR INSTALLATION" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                        <TextBlock Text="Core                         UP TO DATE" Margin="0,8" /><TextBlock Text="Nation Selector          UP TO DATE" Margin="0,8" /><TextBlock Text="Contract Pack            UP TO DATE" Margin="0,8" /><TextBlock Text="KSR Suits                  NOT INSTALLED · SKIPPED" Foreground="{StaticResource MutedBrush}" Margin="0,8" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="AdminArea" Grid.Row="2" Margin="28,18,28,10" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="MANAGED CAMPAIGN" Style="{StaticResource SectionTitle}" /><TextBlock Text="KSR-000042-20260819-0015" Margin="0,8,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="ACTIVE" Foreground="{StaticResource GreenBrush}" FontSize="18" Margin="0,8,0,0" /></StackPanel>
                    <Button Grid.Column="2" Content="COPY ID" />
                </Grid>
            </Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PARTICIPANTS AND NATIONS" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" /><TextBlock Text="Fabio (You)       USSR       ADMIN       READY" Margin="0,10" /><TextBlock Text="Marco                 USA         PLAYER      READY" Margin="0,10" /><TextBlock Text="Luca                    JAPAN      PLAYER      READY" Margin="0,10" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MASTER SAVE" Style="{StaticResource SectionTitle}" /><TextBlock Text="AVAILABLE" Foreground="{StaticResource GreenBrush}" FontSize="19" Margin="0,16,0,4" /><TextBlock Text="SHA-256 VERIFIED" /><Button Content="DOWNLOAD COPY" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" /><Button Content="CLOSE CAMPAIGN" Style="{StaticResource DangerButton}" Margin="0,24,0,0" /></StackPanel></Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="28,0,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
            <Button Content="LEADERBOARD" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="SEND LOG" Margin="0,0,12,0" Click="SendLog_Click" />
            <Button Grid.Column="2" Content="SEND SAVE" Margin="0,0,12,0" Click="SendSave_Click" />
            <Button Grid.Column="4" Content="LAUNCH KSP" Style="{StaticResource PrimaryButton}" Click="LaunchKsp_Click" />
        </Grid>
    </Grid>
</Window>
