<Window x:Class="KsrLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KSR Platform" Width="1280" Height="820" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#070A0C" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.52,0.42" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#FF18232B" Offset="0" />
                <GradientStop Color="#FF0B1014" Offset="0.46" />
                <GradientStop Color="#FF050708" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="92" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF101417" BorderBrush="#FF303538" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KSR" Foreground="{StaticResource OrangeBrush}" FontWeight="Black" />
                    <TextBlock Text="  /  PLATFORM" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click" />
                    <Button Content="□" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Maximize_Click" />
                    <Button Content="✕" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Persistent account and server bar -->
        <Border Grid.Row="1" Margin="18,14,18,0" Background="#F2080B0D" BorderBrush="#FF4A3A27"
                BorderThickness="1" CornerRadius="7">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KSR" Foreground="{StaticResource OrangeBrush}" FontSize="42" FontWeight="Black" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KERBAL SPACE RACE" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="LAUNCHER  ·  V1.0.0" Style="{StaticResource SmallLabel}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#FF303538" Margin="0,16" />

                <Grid Grid.Column="2" Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SIGNED IN AS" Style="{StaticResource SmallLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="28" Height="28" Background="#FF20262A" BorderBrush="#FF555A5D" BorderThickness="1" CornerRadius="14">
                                <TextBlock Text="●" Foreground="#FFD7D3CB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                            </Border>
                            <TextBlock x:Name="AccountNameText" Text="PLAYER" FontSize="19" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Height="35" Background="#FF303538" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="KSR NETWORK" Style="{StaticResource SmallLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="ServerStatusDot" Text="●" Foreground="{StaticResource GreenBrush}" FontSize="19" />
                            <TextBlock x:Name="ServerStatusText" Text="SERVER ONLINE" Foreground="{StaticResource GreenBrush}"
                                       FontSize="15" FontWeight="Bold" Margin="8,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Height="35" Background="#FF303538" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE CAMPAIGN" Style="{StaticResource SmallLabel}" />
                        <TextBlock Text="SPACE RACE 2026" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="3" Background="#FF303538" Margin="0,16" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Button Content="SETTINGS" Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
                    <Button Content="SIGN OUT" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Browser-like area tabs -->
        <Grid Grid.Row="2" Margin="18,12,18,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="PlayerTabButton" Grid.Column="0" Content="PLAYER AREA" Style="{StaticResource TabButton}"
                    Foreground="{StaticResource OrangeBrush}" BorderBrush="{StaticResource OrangeBrush}" Click="PlayerTab_Click" />
            <Button x:Name="AdminTabButton" Grid.Column="1" Content="ADMIN AREA" Style="{StaticResource TabButton}"
                    Foreground="{StaticResource MutedBrush}" Click="AdminTab_Click" />
        </Grid>

        <!-- Player area -->
        <Grid x:Name="PlayerArea" Grid.Row="3" Margin="18,16,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MY CAMPAIGNS" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Select the campaign you want to play." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+  JOIN CAMPAIGN" Style="{StaticResource GhostButton}" />
                    </Grid>

                    <Border Grid.Row="2" Background="#E30A0E11" BorderBrush="#FF34383B" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="66" />
                                <RowDefinition Height="66" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*" />
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="5" Background="#FF171C20" CornerRadius="5,5,0,0" />
                            <TextBlock Text="CAMPAIGN ID" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="1" Text="CAMPAIGN" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="2" Text="ROLE" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="3" Text="NATION" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#151F8A12" BorderBrush="#FF2A2F32" BorderThickness="0,0,0,1" />
                            <TextBlock Grid.Row="1" Text="KSR-000042-20260819-0015" Margin="14" VerticalAlignment="Center" FontSize="15" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Space Race 2026" Margin="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="ADMIN" Margin="14" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="USSR" Margin="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="14" VerticalAlignment="Center">
                                <TextBlock Text="●" Foreground="{StaticResource GreenBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="ACTIVE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="KSR-000077-20260820-192600" Margin="14" VerticalAlignment="Center" FontSize="15" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Race to Duna" Margin="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="PLAYER" Margin="14" Foreground="#FF4AB8F1" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="USA" Margin="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Margin="14" VerticalAlignment="Center">
                                <TextBlock Text="●" Foreground="{StaticResource GreenBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="ACTIVE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#99101518" BorderBrush="#FF34383B" BorderThickness="1" CornerRadius="5" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SELECTED CAMPAIGN" Style="{StaticResource SmallLabel}" />
                                <TextBlock Text="Space Race 2026  ·  USSR  ·  Administrator" FontSize="17" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="OPEN CAMPAIGN" Style="{StaticResource PrimaryButton}" MinWidth="190" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="KSR INSTALLATION" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" /></Grid.RowDefinitions>
                            <TextBlock Text="Kerbal Space Race" /><TextBlock Grid.Column="1" Text="UP TO DATE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Text="Nation Selector" /><TextBlock Grid.Row="1" Grid.Column="1" Text="UP TO DATE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Grid.Row="2" Text="Contract Pack" /><TextBlock Grid.Row="2" Grid.Column="1" Text="UP TO DATE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Grid.Row="3" Text="KSR Suits" /><TextBlock Grid.Row="3" Grid.Column="1" Text="NOT INSTALLED · SKIPPED" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="MASTER SAVE" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="The selected campaign save is ready." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,13" />
                        <Button Content="DOWNLOAD VERIFIED SAVE" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="SUPPORT TOOLS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Row="1" Text="Send diagnostics only when you choose to. You can describe the problem before anything is packaged."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Content="SEND LOG" Click="SendLog_Click" />
                            <Button Grid.Column="2" Content="SEND SAVE" Click="SendSave_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Admin area -->
        <Grid x:Name="AdminArea" Grid.Row="3" Margin="18,16,18,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.95*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SPACE RACE 2026" FontSize="25" FontWeight="Bold" />
                            <TextBlock Text="KSR-000042-20260819-0015" Foreground="{StaticResource OrangeBrush}" FontSize="18" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="{StaticResource GreenBrush}" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="CAMPAIGN ACTIVE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <Button Content="COPY ID" Style="{StaticResource GhostButton}" Margin="20,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PARTICIPANTS &amp; NATIONS" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
                        <Border Background="#FF171C20" CornerRadius="4" Padding="14,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="PLAYER" Style="{StaticResource SmallLabel}" /><TextBlock Grid.Column="1" Text="NATION" Style="{StaticResource SmallLabel}" /><TextBlock Grid.Column="2" Text="ROLE" Style="{StaticResource SmallLabel}" /><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource SmallLabel}" />
                            </Grid>
                        </Border>
                        <Grid Margin="14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Fabio (You)" FontSize="16" /><TextBlock Grid.Column="1" Text="USSR" /><TextBlock Grid.Column="2" Text="ADMIN" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" /><TextBlock Grid.Column="3" Text="●  READY" Foreground="{StaticResource GreenBrush}" />
                        </Grid>
                        <Border Height="1" Background="#FF303538" />
                        <Grid Margin="14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Marco" FontSize="16" /><TextBlock Grid.Column="1" Text="USA" /><TextBlock Grid.Column="2" Text="PLAYER" /><TextBlock Grid.Column="3" Text="●  READY" Foreground="{StaticResource GreenBrush}" />
                        </Grid>
                        <Border Height="1" Background="#FF303538" />
                        <Grid Margin="14,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="Luca" FontSize="16" /><TextBlock Grid.Column="1" Text="JAPAN" /><TextBlock Grid.Column="2" Text="PLAYER" /><TextBlock Grid.Column="3" Text="●  READY" Foreground="{StaticResource GreenBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CAMPAIGN INFORMATION" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Mode                         Sandbox" Margin="0,14,0,5" />
                        <TextBlock Text="Difficulty                    Normal" Margin="0,5" />
                        <TextBlock Text="Master Save                Verified" Margin="0,5" />
                        <TextBlock Text="Participants                3 / 8" Margin="0,5" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="MASTER SAVE" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="AVAILABLE · SHA-256 VERIFIED" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" Margin="0,14,0,12" />
                        <Button Content="DOWNLOAD COPY" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="DANGER ZONE" Foreground="#FFFF5757" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Closing a campaign is irreversible." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14" />
                        <Button Content="CLOSE CAMPAIGN" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Persistent footer -->
        <Border Grid.Row="4" Background="#E6080B0D" BorderBrush="#FF2E3336" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="LEADERBOARD" Style="{StaticResource GhostButton}" MinWidth="160" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="KERBAL SPACE RACE  ·  FLY TOGETHER, WIN TOGETHER"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="LAUNCH KSP" Style="{StaticResource PrimaryButton}" MinWidth="260"
                        VerticalAlignment="Center" Click="LaunchKsp_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
