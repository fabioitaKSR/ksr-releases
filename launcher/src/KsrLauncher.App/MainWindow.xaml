<Window x:Class="KsrLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KSR Platform" Icon="Assets/ksr-launcher.ico" Width="1280" Height="820" MinWidth="1080" MinHeight="720"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" Background="#070A0C" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.52,0.42" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#FF18232B" Offset="0" />
                <GradientStop Color="#FF0B1014" Offset="0.46" />
                <GradientStop Color="#FF050708" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="112" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="5" Source="Assets/ksr-space-background-v1.png" Stretch="UniformToFill"
               Opacity="0.24" IsHitTestVisible="False" />
        <Image Grid.Row="3" Source="Assets/ksr-astronaut-v1.png" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Height="640" Margin="0,0,35,-18" Opacity="0.38" IsHitTestVisible="False" />

        <Border x:Name="ModUpdateOverlay" Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="100"
                Background="#D905080A" Visibility="Collapsed">
            <Border Width="590" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FF0D1215" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                    <TextBlock Text="KSR MOD UPDATE" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ModUpdatePhaseText" Text="CHECKING INSTALLED KSR MODS"
                               Foreground="{StaticResource GreenBrush}" FontSize="18" FontWeight="Bold" Margin="0,18,0,6" />
                    <TextBlock x:Name="ModUpdateDetailText" Text="Reading the local installation..."
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,15" />
                    <ProgressBar x:Name="ModUpdateProgressBar" Height="12" Minimum="0" Maximum="100"
                                 Value="0" IsIndeterminate="True" Foreground="{StaticResource GreenBrush}" />
                    <TextBlock Text="Do not start KSP or close the launcher while files are being installed."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,13,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Row="0" Background="#FF101417" BorderBrush="#FF303538" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KSR" Foreground="{StaticResource OrangeBrush}" FontWeight="Black" />
                    <TextBlock Text="  /  PLATFORM" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click" />
                    <Button Content="□" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Maximize_Click" />
                    <Button Content="✕" Width="46" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Persistent account and server bar -->
        <Border Grid.Row="1" Margin="18,14,18,0" Background="#F2080B0D" BorderBrush="#FF4A3A27"
                BorderThickness="1" CornerRadius="7">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KSR" Foreground="{StaticResource OrangeBrush}" FontSize="42" FontWeight="Black" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KERBAL SPACE RACE" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="LauncherVersionText" Text="LAUNCHER  ·  v0.1.10"
                                   Style="{StaticResource SmallLabel}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#FF303538" Margin="0,16" />

                <Grid x:Name="AccountPanel" Grid.Column="2" Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SIGNED IN AS" Style="{StaticResource SmallLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Width="28" Height="28" Background="#FF20262A" BorderBrush="#FF555A5D" BorderThickness="1" CornerRadius="14">
                                <TextBlock Text="●" Foreground="#FFD7D3CB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                            </Border>
                            <TextBlock x:Name="AccountNameText" Text="PLAYER" FontSize="19" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Height="35" Background="#FF303538" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="KSR NETWORK" Style="{StaticResource SmallLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="ServerStatusDot" Text="●" Foreground="{StaticResource GreenBrush}" FontSize="19" />
                            <TextBlock x:Name="ServerStatusText" Text="SERVER ONLINE" Foreground="{StaticResource GreenBrush}"
                                       FontSize="15" FontWeight="Bold" Margin="8,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Height="35" Background="#FF303538" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE CAMPAIGN" Style="{StaticResource SmallLabel}" />
                        <TextBlock x:Name="ActiveCampaignText" Text="NO CAMPAIGN SELECTED" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="LoginPanel" Grid.Column="2" Margin="24,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KSR USERNAME" Style="{StaticResource SmallLabel}" />
                        <TextBox x:Name="LoginUsernameTextBox" MinWidth="115" Margin="0,5,0,0" />
                        <CheckBox x:Name="RememberMeCheckBox" Content="REMEMBER ME" FontSize="10"
                                  Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="PASSWORD" Style="{StaticResource SmallLabel}" />
                            <Button Grid.Column="1" Content="FORGOT PASSWORD?" Style="{StaticResource GhostButton}" FontSize="10"
                                    Padding="5,0" BorderThickness="0" Click="ForgotPassword_Click" />
                        </Grid>
                        <PasswordBox x:Name="LoginPasswordBox" MinWidth="115" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="KSR NETWORK" Style="{StaticResource SmallLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock x:Name="LoginServerStatusDot" Text="●" Foreground="{StaticResource OrangeBrush}" FontSize="17" />
                            <TextBlock x:Name="LoginServerStatusText" Text="SETUP PENDING" Foreground="{StaticResource OrangeBrush}"
                                       FontWeight="Bold" Margin="7,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="SignInButton" Grid.Column="6" Content="SIGN IN" Style="{StaticResource PrimaryButton}" MinWidth="105"
                            VerticalAlignment="Center" Click="SignIn_Click" />
                    <TextBlock x:Name="AuthFeedbackText" Grid.Row="1" Grid.ColumnSpan="7" Visibility="Collapsed"
                               Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Column="3" Background="#FF303538" Margin="0,16" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Button Content="SETTINGS" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Settings_Click" />
                    <Button x:Name="CreateAccountButton" Content="CREATE ACCOUNT" Style="{StaticResource GhostButton}"
                            Visibility="Collapsed" Click="CreateAccount_Click" />
                    <Button x:Name="SignOutButton" Content="SIGN OUT" Style="{StaticResource GhostButton}" Click="SignOut_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Browser-like area tabs -->
        <Grid Grid.Row="2" Margin="18,12,18,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="PlayerTabButton" Grid.Column="0" Content="PLAYER AREA" Style="{StaticResource TabButton}"
                    Foreground="{StaticResource OrangeBrush}" BorderBrush="{StaticResource OrangeBrush}" Click="PlayerTab_Click" />
            <Button x:Name="AdminTabButton" Grid.Column="1" Content="ADMIN AREA" Style="{StaticResource TabButton}"
                    Foreground="{StaticResource MutedBrush}" Click="AdminTab_Click" />
        </Grid>

        <!-- Player area -->
        <Grid x:Name="PlayerArea" Grid.Row="3" Margin="18,16,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MY CAMPAIGNS" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Select the campaign you want to play." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="RefreshCampaignsButton" Content="REFRESH" Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" Click="RefreshCampaigns_Click" />
                            <Button x:Name="JoinCampaignButton" Content="+  JOIN CAMPAIGN" Style="{StaticResource GhostButton}"
                                    Click="JoinCampaign_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#E30A0E11" BorderBrush="#FF34383B" BorderThickness="1" CornerRadius="5" MinHeight="230">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Background="#FF171C20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="CAMPAIGN ID" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="1" Text="CAMPAIGN" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="2" Text="ROLE" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="3" Text="NATION" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="5" Text="" Style="{StaticResource TableHeader}" />
                            </Grid>

                            <ListBox x:Name="CampaignsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="CampaignsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Foreground" Value="#FFF0EEE9" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent" BorderBrush="#FF2A2F32" BorderThickness="0,0,0,1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#162C86A0" /></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#201F8A12" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="66">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Margin="14,8" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CampaignCode}" VerticalAlignment="Center" FontSize="15"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Content="COPY ID" Style="{StaticResource GhostButton}"
                                                        Padding="10,5" MinWidth="72" Margin="10,0,0,0"
                                                        ToolTip="Copy this Campaign ID to the clipboard"
                                                        Click="CopyCampaignId_Click" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Role}" Margin="14" Foreground="{Binding RoleColor}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Nation}" Margin="14" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="14" VerticalAlignment="Center">
                                                <TextBlock Text="●" Foreground="{Binding StatusColor}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" />
                                            </StackPanel>
                                            <Button Grid.Column="5" Content="REMOVE"
                                                    Padding="10,5" MinWidth="82" Margin="4,0,12,0"
                                                    ToolTip="Remove this closed campaign from your list. Results and history are preserved."
                                                    Click="DismissClosedCampaign_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="CLOSED">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="EmptyCampaignsPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="NO CAMPAIGNS YET" Foreground="{StaticResource MutedBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Join a campaign or wait for one to be assigned to your account." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#99101518" BorderBrush="#FF34383B" BorderThickness="1" CornerRadius="5" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SELECTED CAMPAIGN" Style="{StaticResource SmallLabel}" />
                                <TextBlock x:Name="SelectedCampaignText" Text="NO CAMPAIGN SELECTED" Foreground="{StaticResource MutedBrush}" FontSize="17" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button x:Name="OpenCampaignButton" Grid.Column="1" Content="OPEN CAMPAIGN" Style="{StaticResource PrimaryButton}" MinWidth="190" IsEnabled="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="KSR INSTALLATION" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" /></Grid.RowDefinitions>
                            <TextBlock Text="Kerbal Space Race" /><TextBlock Grid.Column="1" Text="UP TO DATE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Text="Nation Selector" /><TextBlock Grid.Row="1" Grid.Column="1" Text="UP TO DATE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Grid.Row="2" Text="Contract Pack" /><TextBlock Grid.Row="2" Grid.Column="1" Text="UP TO DATE" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" />
                            <TextBlock Grid.Row="3" Text="KSR Suits" /><TextBlock Grid.Row="3" Grid.Column="1" Text="NOT INSTALLED · SKIPPED" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="MASTER SAVE" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="MasterSaveStatusText" Text="Select a campaign to check its Master Save." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,13" />
                        <Button x:Name="DownloadMasterSaveButton" Content="DOWNLOAD VERIFIED SAVE" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="DownloadMasterSave_Click" />
                        <TextBlock x:Name="CampaignComplianceStatusText" Text="Campaign compliance has not been checked."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,13,0,9" />
                        <TextBlock x:Name="PlayerLaunchAndLogsStatusText" Text="Launch &amp; Logs installation has not been checked."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,7" />
                        <ProgressBar x:Name="PlayerLaunchAndLogsProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource TerminalGreenBrush}" Background="#FF0A160B" Margin="0,0,0,8"
                                     Visibility="Collapsed" />
                        <Button x:Name="PlayerDownloadLaunchAndLogsButton" Content="DOWNLOAD LAUNCH &amp; LOGS"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                                Click="PlayerDownloadLaunchAndLogs_Click" />
                        <Button x:Name="CheckInstallationButton" Content="CHECK INSTALLATION" IsEnabled="False"
                                Click="CheckInstallation_Click" />
                        <Button x:Name="ViewIgnoredModsButton" Content="VIEW IGNORED MODS" IsEnabled="False"
                                Margin="0,8,0,0" Click="ViewIgnoredMods_Click" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- Admin area -->
        <Grid x:Name="AdminArea" Grid.Row="3" Margin="18,16,18,10" Visibility="Collapsed">
            <Border x:Name="LaunchAndLogsSetupPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LAUNCH &amp; LOGS SETUP" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Install the official KSR race tools before creating a campaign. Select your Kerbal Space Program folder; the launcher will install only the required GameData folders and preserve user settings."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
                        <TextBlock Text="KERBAL SPACE PROGRAM FOLDER" Style="{StaticResource SmallLabel}" />
                        <Grid Margin="0,7,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="LaunchAndLogsKspPathTextBox" IsReadOnly="True" Text="No KSP folder selected" Foreground="{StaticResource MutedBrush}" />
                            <Button Grid.Column="2" Content="SELECT KSP FOLDER" Style="{StaticResource GhostButton}" MinWidth="170" Click="SelectLaunchAndLogsKspFolder_Click" />
                        </Grid>

                        <Border Background="#CC101518" BorderBrush="#FF3B3E40" BorderThickness="1" CornerRadius="5" Padding="16">
                            <StackPanel>
                                <TextBlock Text="KSR COMPONENTS" Foreground="{StaticResource OrangeBrush}" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="KSR Core + Remote Logger — securely sends race events to the campaign server." TextWrapping="Wrap" Margin="0,10,0,4" />
                                <TextBlock Text="Parameter Logger — records contracts, parameters and individual achievements." TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="Nation Selector — assigns the player's nation and applies campaign identity." TextWrapping="Wrap" Margin="0,0,0,4" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Approximate download: 7.4 MB  ·  Installed size: 18 MB"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#D90B0F12" BorderBrush="#FF3B3E40" BorderThickness="1" CornerRadius="6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACHIEVEMENTS &amp; DEPENDENCIES" Foreground="{StaticResource OrangeBrush}" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="Achievements adds approximately 145 in-game milestones. KSR records each milestone and awards race points to the first three agencies that complete it."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <Button Content="ACHIEVEMENTS 1.10.2  ·  GPLv3  ·  ~6.3 MB" Tag="https://forum.kerbalspaceprogram.com/topic/193073-112x-achievements-updated-dependencies-updated-11302020/" Click="OpenExternalReference_Click" HorizontalContentAlignment="Left" />
                                <Button Content="CLICK THROUGH BLOCKER  ·  GPLv3  ·  ~0.2 MB" Tag="https://forum.kerbalspaceprogram.com/topic/170747-112x-click-through-blocker-new-dependency/" Click="OpenExternalReference_Click" HorizontalContentAlignment="Left" Margin="0,7,0,0" />
                                <Button Content="TOOLBAR CONTROLLER  ·  ~0.2 MB" Tag="https://forum.kerbalspaceprogram.com/topic/169509-112x-toolbar-controller-for-modders/" Click="OpenExternalReference_Click" HorizontalContentAlignment="Left" Margin="0,7,0,0" />
                                <Button Content="SPACETUX LIBRARY  ·  ~0.6 MB" Tag="https://github.com/linuxgurugamer/SpaceTuxLibrary/releases" Click="OpenExternalReference_Click" HorizontalContentAlignment="Left" Margin="0,7,0,0" />
                                <TextBlock Text="External projects remain credited to their authors. Their original license and reference files are included unchanged."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="3">
                                <TextBlock x:Name="LaunchAndLogsStatusText" Text="Select the KSP folder to check the required components."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <ProgressBar x:Name="LaunchAndLogsProgressBar" Height="8" Minimum="0" Maximum="1" Value="0"
                                             Foreground="{StaticResource TerminalGreenBrush}" Background="#FF0A160B" Margin="0,0,0,12" />
                                <Button x:Name="DownloadLaunchAndLogsButton" Content="DOWNLOAD LAUNCH &amp; LOGS" Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False" Click="DownloadLaunchAndLogs_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="AdminCampaignPanel" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CREATE A RACE" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Row="1" Text="Prepare a Career or Science save in KSP, then select it here as the official campaign starting point. Sandbox saves are not allowed."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="CAMPAIGN NAME" Style="{StaticResource SmallLabel}" />
                            <TextBox x:Name="CampaignNameTextBox" Margin="0,6,0,16" MaxLength="80" TextChanged="CampaignCreationInput_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="REFERENCE CAREER SAVE" Style="{StaticResource SmallLabel}" />
                            <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReferenceSavePathTextBox" IsReadOnly="True" Text="No save selected" Foreground="{StaticResource MutedBrush}" />
                            <Button x:Name="BrowseReferenceSaveButton" Grid.Column="2" Content="BROWSE SAVE" Style="{StaticResource GhostButton}" MinWidth="145"
                                    Click="BrowseReferenceSave_Click" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="4" Margin="0,15,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="IGNORED GAMEDATA FOLDERS" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Margin="8,0,0,0"
                                    Background="#FF20262A" BorderBrush="#FF777B7E" BorderThickness="1"
                                    ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                                <Border.ToolTip>
                                    <ToolTip Background="#FF11171B" BorderBrush="{StaticResource OrangeBrush}"
                                             BorderThickness="1" Padding="12" Placement="Mouse">
                                        <TextBlock Width="360" TextWrapping="Wrap" Foreground="#FFF0EEE9" FontSize="13"
                                                   Text="Select one or more optional mod folders located directly inside this installation's GameData. The launcher ignores those folders and all their contents during campaign checks. Protected KSP and KSR folders cannot be ignored." />
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="?" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="5" MinHeight="130">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="#FF0B0F12" BorderBrush="#FF44494C" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="IgnoredGameDataFoldersList" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource ForegroundBrush}" SelectionMode="Extended"
                                             SelectionChanged="IgnoredGameDataFoldersList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="10,7">
                                                    <TextBlock Text="▰" Foreground="{StaticResource OrangeBrush}" Margin="0,0,9,0" />
                                                    <TextBlock Text="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="IgnoredFoldersEmptyText" Text="No ignored mod folders selected."
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SelectIgnoredFoldersButton" Content="SELECT MOD FOLDERS" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" IsEnabled="False" Click="SelectIgnoredFolders_Click" />
                                <Button x:Name="RemoveIgnoredFoldersButton" Grid.Column="2" Content="REMOVE SELECTED"
                                        Style="{StaticResource GhostButton}" IsEnabled="False" Click="RemoveIgnoredFolders_Click" />
                                <Button x:Name="ClearIgnoredFoldersButton" Grid.Column="4" Content="CLEAR ALL"
                                        Style="{StaticResource GhostButton}" IsEnabled="False" Click="ClearIgnoredFolders_Click" />
                            </Grid>
                        </Grid>

                        <Border Grid.Row="6" Background="#CC101518" BorderBrush="#FF3B3E40" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="KSP INSTALLATION" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ResolvedKspPathText" Grid.Column="2" Text="Resolved automatically from the selected save"
                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Background="#D90B0F12" BorderBrush="#FF3B3E40" BorderThickness="1" CornerRadius="6" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="CAMPAIGN BASELINE" Foreground="{StaticResource OrangeBrush}" FontSize="19" FontWeight="Bold" />
                                <TextBlock Text="The selected installation becomes the compatibility reference for this campaign."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="✓ Complete starting Master Save" Margin="0,0,0,9" />
                                    <TextBlock Text="✓ Career or Science difficulty and save-scoped mod settings" Margin="0,0,0,9" />
                                    <TextBlock Text="✓ GameData mod inventory and file hashes" Margin="0,0,0,9" />
                                    <TextBlock Text="✓ Approved gameplay configuration" Margin="0,0,0,9" />
                                    <TextBlock Text="Private data, credentials, caches and logs are excluded." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>

                                <Border Grid.Row="2" MinHeight="145" Background="#F2050B06" BorderBrush="#FF3B7F35"
                                        BorderThickness="1" CornerRadius="4" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="KSR BASELINE SCANNER" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#FF57C94E" FontWeight="Bold" />
                                        <TextBlock x:Name="BaselineActivityStageText" Grid.Row="1" Text="&gt; WAITING FOR SAVE SELECTION"
                                                   FontFamily="Consolas" FontSize="16" Foreground="{StaticResource TerminalGreenBrush}" FontWeight="Bold"
                                                   Margin="0,8,0,0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#FF65FF45" BlurRadius="7" ShadowDepth="0" Opacity="0.65" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <ProgressBar x:Name="BaselineActivityProgressBar" Grid.Row="3" Height="8"
                                                     Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource TerminalGreenBrush}"
                                                     Background="#FF0A160B" BorderBrush="#FF285426" BorderThickness="1" />
                                        <TextBlock x:Name="BaselineActivityDetailText" Grid.Row="4"
                                                   Text="Select a valid Career or Science save to initialize the scanner."
                                                   FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TerminalDimGreenBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="4">
                                <TextBlock x:Name="CampaignCreationStatusText" Text="Select a Career or Science save to continue."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button x:Name="CreateRaceButton" Content="CREATE RACE" Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False" Click="CreateRace_Click" />
                                <Button x:Name="RetryCampaignUploadButton" Content="RETRY CAMPAIGN UPLOAD" Style="{StaticResource PrimaryButton}"
                                        Visibility="Collapsed" IsEnabled="False" Click="RetryCampaignUpload_Click" />
                                <Button x:Name="CloseCampaignButton" Content="CLOSE CAMPAIGN" Style="{StaticResource DangerButton}"
                                        Visibility="Collapsed" IsEnabled="False" Click="CloseCampaign_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Persistent footer -->
        <Border Grid.Row="4" Background="#E6080B0D" BorderBrush="#FF2E3336" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LeaderboardButton" Content="LEADERBOARD" Style="{StaticResource GhostButton}"
                        MinWidth="150" VerticalAlignment="Center" IsEnabled="False" Click="Leaderboard_Click" />
                <Button x:Name="SendLogButton" Grid.Column="2" Content="SEND LOG" Style="{StaticResource GhostButton}"
                        MinWidth="105" VerticalAlignment="Center" Click="SendLog_Click" />
                <Button x:Name="SendSaveButton" Grid.Column="4" Content="SEND SAVE" Style="{StaticResource GhostButton}"
                        MinWidth="105" VerticalAlignment="Center" Click="SendSave_Click"
                        ToolTip="Choose the KSP save folder to include in the report" />
                <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="YOUR MODS. YOUR RULES. YOUR SPACE RACE."
                               Foreground="{StaticResource MutedBrush}" FontSize="13"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="by KerbalSpaceRace" Foreground="{StaticResource MutedBrush}"
                               FontSize="9" Opacity="0.78" Margin="0,2,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
                <Button x:Name="LaunchKspButton" Grid.Column="6" Content="LAUNCH KSP" Style="{StaticResource PrimaryButton}" MinWidth="260"
                        VerticalAlignment="Center" Click="LaunchKsp_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
