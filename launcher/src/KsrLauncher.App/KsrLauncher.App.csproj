<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KsrLauncher.Core\KsrLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ksr-space-background-v1.png" />
    <Resource Include="Assets\ksr-astronaut-v1.png" />
    <Resource Include="Assets\ksr-launcher.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.7.32</Version>
    <InformationalVersion>0.7.32</InformationalVersion>
    <!-- The updater distributes only the executable. WPF native libraries must travel with it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\ksr-launcher.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
