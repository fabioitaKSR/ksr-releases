<Window x:Class="KsrLauncher.App.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSR Settings" Width="650" Height="330" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="KSR SERVER" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Configure the public address used by this launcher." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="SERVER URL" Style="{StaticResource SmallLabel}" />
        <TextBox x:Name="ServerUrlTextBox" Grid.Row="4" FontSize="16" />
        <TextBlock Grid.Row="5" Text="Use the stable HTTPS Cloudflare address. HTTP is accepted only for localhost development. Authentication tokens are never stored in this setting."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="CANCEL" MinWidth="105" Click="Cancel_Click" />
            <Button Grid.Column="3" Content="SAVE" MinWidth="125" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
