<Window x:Class="KsrLauncher.App.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSR Settings" Width="760" Height="550" MinWidth="680" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="KSR SERVER" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Configure the public address used by this launcher." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="SERVER URL" Style="{StaticResource SmallLabel}" />
        <TextBox x:Name="ServerUrlTextBox" Grid.Row="4" FontSize="16" />
        <TextBlock Grid.Row="5" Text="Use the stable HTTPS Cloudflare address. HTTP is accepted only for localhost development. Authentication tokens are never stored in this setting."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock Grid.Row="7" Text="TEST GAME INSTALLATION" Style="{StaticResource SectionTitle}" />
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TestKspPathTextBox" IsReadOnly="True" Text="No test installation selected"
                     VerticalContentAlignment="Center" />
            <Button x:Name="BrowseTestKspButton" Grid.Column="2" Content="BROWSE" MinWidth="90" Click="BrowseTestKsp_Click" />
            <Button x:Name="ClearTestKspButton" Grid.Column="4" Content="CLEAR" MinWidth="70" Click="ClearTestKsp_Click" />
        </Grid>
        <TextBlock Grid.Row="10" Text="Choose the KSP folder used for the existing test game. You can use the same installation as a campaign; test launch clears its campaign ticket."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <Grid Grid.Row="11" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpgradeTestKspButton" Content="UPGRADE" MinWidth="115" Click="UpgradeTestKsp_Click" />
            <Button x:Name="RepairTestKspButton" Grid.Column="2" Content="REPAIR" MinWidth="115" Click="RepairTestKsp_Click" />
            <TextBlock x:Name="TestKspMaintenanceStatus" Grid.Column="3" Margin="14,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </Grid>
        <ProgressBar x:Name="TestKspMaintenanceProgress" Grid.Row="13" Height="8" Minimum="0" Maximum="100"
                     Visibility="Collapsed" Foreground="{StaticResource GreenBrush}" />
        <Grid Grid.Row="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LaunchTestKspButton" Content="LAUNCH TEST GAME" MinWidth="165"
                    Click="LaunchTestKsp_Click" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="CANCEL" MinWidth="105" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Grid.Column="4" Content="SAVE" MinWidth="125" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
