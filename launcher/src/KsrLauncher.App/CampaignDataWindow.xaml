<Window x:Class="KsrLauncher.App.CampaignDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch and Log — Campaign Data" Width="720" Height="630" MinWidth="640" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CAMPAIGN DATA" Style="{StaticResource SectionTitle}" FontSize="27" />
            <TextBlock Text="How campaign data is used and what is made public."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CAMPAIGN RECORDS" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Campaign gameplay data is collected to calculate race standings. Account information is handled separately."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="ANONYMOUS RACE ARCHIVES" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Only completed and closed races appear on the public archive page. Each race has its own CSV file, such as race-01.csv, containing the full chronological list of registered records and contract entries."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock Text="Labels such as Agency 1 and Agency 2 stay consistent within each race. Game contract codes, dates, times and values are preserved; player names and real agency names are excluded."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="FUTURE BOT PLAYERS" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Anonymous race histories help us understand how races unfolded and support the future development of bot players in Launch and Log."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="VIEW ANONYMOUS RACE ARCHIVES" Click="ViewArchives_Click" />
            <Button Grid.Column="2" Content="CLOSE" MinWidth="100" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
