<Window x:Class="KsrLauncher.App.CampaignDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch and Log — Campaign Data" Width="720" Height="780" MinWidth="640" MinHeight="480"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CAMPAIGN DATA" Style="{StaticResource SectionTitle}" FontSize="27" />
            <TextBlock Text="How campaign data is used and what is made public."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="MY CAMPAIGN DATA CHOICE" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Campaign" Margin="0,12,0,6" />
                        <ComboBox x:Name="CampaignSelector" SelectionChanged="Campaign_Changed" IsEnabled="False" Foreground="#FF151A1E" FontSize="16" Padding="8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#FF151A1E" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="SavedChoiceText" Text="Loading your campaigns…" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock x:Name="ChoiceStatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ChangeChoiceButton" Content="CHANGE CHOICE" IsEnabled="False" Click="ChangeChoice_Click" Margin="0,0,12,8" />
                            <Button x:Name="StopLoggingButton" Content="STOP LOGGING AND LEAVE" IsEnabled="False" Click="StopLogging_Click" Margin="0,0,12,8" />
                            <Button Content="REFRESH" Click="Refresh_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="Stopping logging applies to normal campaigns and requires the Logging Privacy add-on, loaded after restarting KSP. test1 is unchanged." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" />
                        <TextBlock Margin="0,4,0,0"><Hyperlink Foreground="{StaticResource OrangeBrush}" Click="Privacy_Click">Privacy notice</Hyperlink></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CAMPAIGN RECORDS" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Campaign gameplay data is collected to calculate race standings. Account information is handled separately."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="ANONYMOUS RACE ARCHIVES" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Completed campaigns can publish an automatically checked anonymous CSV containing agency labels, game dates and record descriptions. Results selected for deletion are excluded."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock Text="Labels such as Agency 1 and Agency 2 stay consistent within each race. Game contract codes, dates, times and values are preserved; player names and real agency names are excluded."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="FUTURE BOT PLAYERS" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Anonymous race histories help us understand how races unfolded and support the future development of bot players in Launch and Log."
                                   TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="YOUR ACCOUNT" Style="{StaticResource SectionTitle}" FontSize="17" />
                        <TextBlock Text="Permanently delete your account and identifiable data. Review the consequences before confirming with your username and password." TextWrapping="Wrap" Margin="0,9,0,12" />
                        <Button x:Name="DeleteAccountButton" Content="DELETE ACCOUNT" Click="DeleteAccount_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="VIEW ANONYMOUS RACE ARCHIVES" Click="ViewArchives_Click" />
            <Button Grid.Column="2" Content="CLOSE" MinWidth="100" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
