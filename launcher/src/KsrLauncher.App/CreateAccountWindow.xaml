<Window x:Class="KsrLauncher.App.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create KSR Account" Width="720" Height="720" MinHeight="680" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="20" />
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="18" />
            <RowDefinition Height="Auto" /><RowDefinition Height="18" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CREATE KSR ACCOUNT" Style="{StaticResource SectionTitle}" FontSize="27" />
            <TextBlock Text="Create one account for the KSR Launcher and Kerbal Space Race platform." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="USERNAME" Style="{StaticResource SmallLabel}" />
            <TextBox x:Name="UsernameTextBox" Margin="0,5,0,0" MaxLength="48" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource SmallLabel}" />
            <TextBox x:Name="EmailTextBox" Margin="0,5,0,0" MaxLength="254" />
        </StackPanel>
        <StackPanel Grid.Row="6">
            <TextBlock Text="PASSWORD" Style="{StaticResource SmallLabel}" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,0" MaxLength="128" />
        </StackPanel>
        <StackPanel Grid.Row="8">
            <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource SmallLabel}" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,5,0,0" MaxLength="128" />
        </StackPanel>

        <Border Grid.Row="10" Background="#CC101518" BorderBrush="#FF4A3A27" BorderThickness="1" CornerRadius="6" Padding="18">
            <StackPanel>
                <TextBlock Text="HOW YOUR EMAIL IS USED" Foreground="{StaticResource OrangeBrush}" FontSize="17" FontWeight="Bold" />
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#FFD5D1C9"
                           Text="Your email is private and will never be used for advertising or commercial spam. It may be used only for:" />
                <TextBlock Margin="12,7,0,0" TextWrapping="Wrap" Foreground="#FFD5D1C9"
                           Text="• if you are a campaign administrator: notices concerning suspected cheating, rule enforcement or campaign deadlines;" />
                <TextBlock Margin="12,5,0,0" TextWrapping="Wrap" Foreground="#FFD5D1C9"
                           Text="• if you are a player: only important Kerbal Space Race update notices." />
                <TextBlock Margin="0,7,0,0" Text="Your email is never shown to other players." Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <CheckBox x:Name="EmailUseConsentCheckBox" Grid.Row="12">
            <TextBlock Text="I understand and accept this limited use of my email address." TextWrapping="Wrap" />
        </CheckBox>

        <Grid Grid.Row="14">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="CANCEL" MinWidth="110" Click="Cancel_Click" />
            <Button x:Name="CreateButton" Grid.Column="3" Content="CREATE ACCOUNT" Style="{StaticResource PrimaryButton}" MinWidth="190" Click="Create_Click" />
        </Grid>
    </Grid>
</Window>
