<Application x:Class="KsrLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#070A0C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#E8101417" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#FF151A1E" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#FFF57C00" />
        <SolidColorBrush x:Key="GreenBrush" Color="#FF80D420" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF5A5A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9BA0A3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FF3B3E40" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF0EEE9" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed, Segoe UI" />
            <Setter Property="Foreground" Value="#FFF0EEE9" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF0EEE9" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#BFF57C00" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFE8E5DE" />
            <Setter Property="Background" Value="#FF151A1E" />
            <Setter Property="BorderBrush" Value="#FF45494C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource OrangeBrush}" />
                                <Setter TargetName="Border" Property="Background" Value="#FF20262A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FF090A0B" />
            <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
            <Setter Property="BorderBrush" Value="#FFFF9E32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFF5757" />
            <Setter Property="Background" Value="#441E0808" />
            <Setter Property="BorderBrush" Value="#FFFF3E3E" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FF353A3E" />
            <Setter Property="Foreground" Value="#FFC9C5BD" />
        </Style>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C90B0E10" />
            <Setter Property="BorderBrush" Value="#FF363A3C" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="22,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TableHeader" TargetType="TextBlock" BasedOn="{StaticResource SmallLabel}">
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF0EEE9" />
            <Setter Property="Background" Value="#FF0B0F12" />
            <Setter Property="BorderBrush" Value="#FF44494C" />
            <Setter Property="CaretBrush" Value="{StaticResource OrangeBrush}" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#FFF0EEE9" />
            <Setter Property="Background" Value="#FF0B0F12" />
            <Setter Property="BorderBrush" Value="#FF44494C" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD5D1C9" />
        </Style>
    </Application.Resources>
</Application>
