<Window x:Class="KsrLauncher.App.RemoveCampaignMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Race Participant" Width="680" Height="520" MinWidth="620" MinHeight="450"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="REMOVE PARTICIPANT" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="ParticipantText" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Choose what happens to the results already synchronized with this race."
                   TextWrapping="Wrap" Margin="0,20,0,15" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <RadioButton x:Name="RetainRecordsOption" GroupName="DataDisposition" IsChecked="True"
                         Margin="0,0,0,22" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="KEEP SYNCHRONIZED RECORDS" FontWeight="Bold" />
                    <TextBlock Text="The player loses access and no longer holds back the race date. Their synchronized records, points and nation reservation remain for the rest of the campaign. Their past results continue to count in the standings."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               MaxWidth="520" Margin="0,6,0,0" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="DeleteRecordsOption" GroupName="DataDisposition"
                         VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="DELETE SYNCHRONIZED RACE RECORDS" FontWeight="Bold"
                               Foreground="{StaticResource OrangeBrush}" />
                    <TextBlock Text="Permanently removes this agency's race events, achievement results and locked sheet cells from the server. The nation becomes available again and all standings are recalculated. The player's local KSP save is not deleted."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               MaxWidth="520" Margin="0,6,0,0" />
                </StackPanel>
            </RadioButton>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="CANCEL" MinWidth="115" IsCancel="True" Click="Cancel_Click" />
            <Button Grid.Column="3" Content="REMOVE PLAYER" Style="{StaticResource DangerButton}"
                    MinWidth="170" IsDefault="True" Click="Confirm_Click" />
        </Grid>
    </Grid>
</Window>
