<Window x:Class="KsrLauncher.App.PasswordRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSR Password Recovery" Width="720" Height="700" MinHeight="650" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PASSWORD RECOVERY" Style="{StaticResource SectionTitle}" FontSize="27" />
            <TextBlock Text="Request a reset email or use a reset token you already received." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="1 · REQUEST RESET EMAIL" Foreground="{StaticResource OrangeBrush}" FontSize="18" FontWeight="Bold" />
                <TextBox x:Name="RecoveryEmailTextBox" Grid.Row="2" />
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="For privacy, the result is identical whether or not the address exists." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Button x:Name="RequestButton" Grid.Column="1" Content="SEND RESET EMAIL" MinWidth="180" Click="Request_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="2 · SET A NEW PASSWORD" Foreground="{StaticResource OrangeBrush}" FontSize="18" FontWeight="Bold" />
                <StackPanel Grid.Row="2"><TextBlock Text="RESET TOKEN" Style="{StaticResource SmallLabel}" /><TextBox x:Name="ResetTokenTextBox" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Row="4"><TextBlock Text="NEW PASSWORD" Style="{StaticResource SmallLabel}" /><PasswordBox x:Name="NewPasswordBox" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Row="6"><TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource SmallLabel}" /><PasswordBox x:Name="ConfirmNewPasswordBox" Margin="0,5,0,0" /></StackPanel>
                <Button x:Name="ResetButton" Grid.Row="8" Content="RESET PASSWORD" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="190" Click="Reset_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="6" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>
