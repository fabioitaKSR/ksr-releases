<Window x:Class="KsrLauncher.App.CampaignDataChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campaign data choice" Width="640" Height="430" MinWidth="560" MinHeight="400"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="YOUR CAMPAIGN DATA" Style="{StaticResource SectionTitle}" FontSize="25" />
                <TextBlock Text="At the end of this campaign, what should happen to your campaign data?"
                           TextWrapping="Wrap" Margin="0,12,0,18" />
                <RadioButton x:Name="DeleteChoice" Content="Delete my data" Margin="0,0,0,14" Checked="ChoiceChanged" />
                <RadioButton x:Name="RetainChoice" Content="Keep my data as anonymous race records" Checked="ChoiceChanged" />
                <TextBlock Text="This choice applies only to this campaign. You can change it in DATA while the campaign is active. Your account and installed game files are separate."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,16" />
                <TextBlock><Hyperlink Foreground="{StaticResource OrangeBrush}" Click="Privacy_Click">Privacy notice</Hyperlink></TextBlock>
                <TextBlock Text="The privacy notice page is a placeholder. The full notice will be added later."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCEL" IsCancel="True" Margin="0,0,12,0" MinWidth="100" />
            <Button x:Name="ConfirmButton" Content="CONFIRM CHOICE" IsEnabled="False" Click="Confirm_Click"
                    Style="{StaticResource PrimaryButton}" MinWidth="170" />
        </StackPanel>
    </Grid>
</Window>
