<UserControl x:Class="KsrLauncher.App.OrbitActivityIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" IsHitTestVisible="False" Visibility="Collapsed"
    AutomationProperties.Name="Operation in progress">
    <Viewbox>
        <Canvas Width="64" Height="64">
            <Ellipse Width="30" Height="30" Canvas.Left="17" Canvas.Top="17" Stroke="#38505D" StrokeThickness="1" />
            <Ellipse Width="48" Height="48" Canvas.Left="8" Canvas.Top="8" Stroke="#38505D" StrokeThickness="1" />
            <Ellipse Width="62" Height="62" Canvas.Left="1" Canvas.Top="1" Stroke="#263C48" StrokeThickness="1" />
            <Ellipse Width="9" Height="9" Canvas.Left="27.5" Canvas.Top="27.5" Fill="#FFFF8500" />
            <Canvas Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform x:Name="InnerRotation" /></Canvas.RenderTransform>
                <Ellipse Width="6" Height="6" Canvas.Left="29" Canvas.Top="14" Fill="#FFFFCA65" />
            </Canvas>
            <Canvas Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform x:Name="MiddleRotation" /></Canvas.RenderTransform>
                <Ellipse Width="7" Height="7" Canvas.Left="28.5" Canvas.Top="4.5" Fill="#FF77D6EA" />
            </Canvas>
            <Canvas Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><RotateTransform x:Name="OuterRotation" /></Canvas.RenderTransform>
                <Ellipse Width="5" Height="5" Canvas.Left="29.5" Canvas.Top="0" Fill="#FFB3ED76" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
